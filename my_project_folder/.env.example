# ==============================================================================
# SMARTCHUNK PLATFORM ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Frontend Configuration
# URL of the API Backend (Local dev server or FastAPI)
VITE_API_BASE_URL=http://localhost:8000

# Set to 'true' to use sample papers & offline simulation, or 'false' for live backend
VITE_DEFAULT_DEMO_MODE=true

# 2. Relational Database Configuration (PostgreSQL 16 + pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smartchunk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/smartchunk

# 3. Vector Database Configuration (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=smartchunk_vectors

# 4. Embedding & Model Parameters
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSION=1024
LLM_PROVIDER=openai_or_gemini
LLM_MODEL=gpt-4o-mini

# 5. API Keys (Do not commit actual keys to version control)
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...
